# Скопируйте в .env и заполните.

# Домены API. Пока пусто — Caddy слушает *.localhost с самоподписанным
# сертификатом и наружу ничего не выпускает.
PROD_DOMAIN=
STAGE_DOMAIN=

# Почта для Let's Encrypt: на неё придёт письмо, если сертификат перестанет
# продлеваться.
ACME_EMAIL=

# openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=

# Образ прокси из реестра GitLab. Пусто — собирается локально из caddy/Dockerfile.
CADDY_IMAGE=

# Апстримы API. Значения по умолчанию совпадают с алиасами, которые
# backend/docker-compose.staging.yml выдаёт себе в сети tramplin-edge.
API_PROD_UPSTREAM=tramplin-prod-api:8000
API_STAGE_UPSTREAM=tramplin-stage-api:8000

# 127.0.0.1 — поднять стенд, не публикуя его наружу (проверка, отладка).
EDGE_BIND_HOST=
