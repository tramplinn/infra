{
	email {$ACME_EMAIL}

	admin :2019
	metrics

	log {
		output stdout
		format json
	}
}

(common) {
	encode {
		zstd
		gzip
		match {
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	request_body {
		max_size 10MB
	}
}

{$FRONTEND_DOMAIN:web.localhost} {
	import common

	reverse_proxy {$WEB_PROD_UPSTREAM:tramplin-prod-web:80} {
		flush_interval -1
	}
}

{$PROD_DOMAIN:prod.localhost} {
	import common

	reverse_proxy {$API_PROD_UPSTREAM:tramplin-prod-api:8000} {
		flush_interval -1
	}
}

{$MCP_DOMAIN:mcp.localhost} {
	import common

	reverse_proxy {$MCP_PROD_UPSTREAM:tramplin-mcp-prod-mcp:8001} {
		flush_interval -1
	}
}

{$FRONTEND_STAGE_DOMAIN:web-stage.localhost} {
	import common

	reverse_proxy {$WEB_STAGE_UPSTREAM:tramplin-stage-web:80} {
		flush_interval -1
	}
}

{$STAGE_DOMAIN:stage.localhost} {
	import common

	reverse_proxy {$API_STAGE_UPSTREAM:tramplin-stage-api:8000} {
		flush_interval -1
	}
}

{$MCP_STAGE_DOMAIN:mcp-stage.localhost} {
	import common

	reverse_proxy {$MCP_STAGE_UPSTREAM:tramplin-mcp-stage-mcp:8001} {
		flush_interval -1
	}
}
